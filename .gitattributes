*.csv filter=lfs diff=lfs merge=lfs -text
# Going-forward (decision D-6: no history rewrite): new large binaries use LFS.
# Existing raw-committed blobs stay as-is in history until any future migration
# (e.g. the raw-committed MAIN .zip and RF .joblib are never re-staged).
*.zip filter=lfs diff=lfs merge=lfs -text
*.pcap filter=lfs diff=lfs merge=lfs -text
*.joblib filter=lfs diff=lfs merge=lfs -text
# Tracked thesis PDFs (D-11): treat as binary in merges so parallel phase
# branches never produce text-merge conflicts; main is the only PDF writer.
memoria/memoria.pdf merge=binary -text
report/report.pdf merge=binary -text
